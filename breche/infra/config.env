# Brèche · réglages de la phase 1
# À ajuster après l'état des lieux (00-etat-des-lieux.sh) avant de lancer la suite.

# Interface du réseau maison sur l'hôte Proxmox (celle qui porte 192.168.1.200)
LAN_BRIDGE="vmbr0"
LAN_SUBNET="192.168.1.0/24"

# Réseau de la plateforme (interface, comptes, paiement) : sort sur internet, ne voit pas la maison
PLAT_BRIDGE="vmbr1"
PLAT_HOST_IP="10.10.1.1/24"
PLAT_SUBNET="10.10.1.0/24"
PLAT_VM_IP="10.10.1.10"

# Réseau des labs : ni internet, ni maison, ni hôte Proxmox
LABS_BRIDGE="vmbr2"
LABS_HOST_IP="10.10.2.1/24"
LABS_SUBNET="10.10.2.0/24"
LABS_VM_IP="10.10.2.10"

# Machines virtuelles (identifiants choisis loin de ceux déjà utilisés : à vérifier)
STORAGE="local-lvm"
BRECHE_VMID="9101"
BRECHE_CORES="2"
BRECHE_RAM_MB="4096"
BRECHE_DISK="20G"
LABS_VMID="9102"
LABS_CORES="6"
LABS_RAM_MB="12288"
LABS_DISK="60G"

# Image Debian 12 « cloud » utilisée pour les deux VM
DEBIAN_IMG_URL="https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2"
DEBIAN_IMG="/var/lib/vz/template/iso/debian-12-genericcloud-amd64.qcow2"

# Clé SSH publique autorisée dans les VM (celle de l'hôte par défaut)
SSH_PUBKEY_FILE="/root/.ssh/id_rsa.pub"
VM_USER="breche"
